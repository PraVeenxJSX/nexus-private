# Copy this file to .env. Never commit .env or share your API key.
APP_NAME=NexusAI
ENVIRONMENT=development
SECRET_KEY=replace-with-a-random-64-character-secret
ACCESS_TOKEN_EXPIRE_MINUTES=1440
DATABASE_URL=sqlite+aiosqlite:///./nexusai.db

# NVIDIA NIM (default provider)
LLM_PROVIDER=nvidia
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=nvidia/nemotron-3-ultra-550b-a55b

# Optional OpenAI fallback (only needed if LLM_PROVIDER=openai)
OPENAI_API_KEY=

OPENAI_MODEL=gpt-4o-mini

# Local embeddings (downloaded on first run; no paid embedding API key)
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
VECTOR_STORE_PATH=./storage/chroma
UPLOAD_DIR=./storage/uploads
MAX_UPLOAD_MB=20
CORS_ORIGINS=https://your-project.vercel.app
